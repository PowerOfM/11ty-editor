---
/**
 * Every page imports this component, so every page carries the same `data-ed`
 * paths. That is the entire propagation mechanism: the client edits
 * `footer.tagline` once, and the editor patches it everywhere it appears.
 *
 * Note that `ed()` spreads onto elements that already exist — annotating this
 * component added no wrappers and changed no layout.
 *
 * Comments live in the frontmatter fence rather than in HTML comments, because
 * HTML comments are emitted verbatim and would ship to the client's visitors.
 */
import { ed, edIndex } from '@astro-editor/astro/runtime'
import { footer } from '../lib/content'
---

<footer class="site-footer">
  <p class="tagline" {...ed('footer.tagline')}>{footer.tagline}</p>

  <nav aria-label="Footer">
    <ul>
      {
        footer.links.map((link, index) => (
          <li>
            <a href={link.href} {...ed(edIndex('footer.links', index, 'text'))}>
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <p class="copyright" {...ed('footer.copyright')}>{footer.copyright}</p>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    padding: 2rem 0 3rem;
    border-top: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
    display: grid;
    gap: 0.75rem;
  }

  .tagline {
    margin: 0;
    font-size: 1.05rem;
    color: var(--color-brand);
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  nav a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .copyright {
    margin: 0;
    font-size: 0.875rem;
    opacity: 0.65;
  }
</style>
