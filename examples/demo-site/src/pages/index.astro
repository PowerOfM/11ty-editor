---
import { ed } from '@astro-editor/astro/runtime'
import { getEntry, render } from 'astro:content'
import Base from '../layouts/Base.astro'

const entry = await getEntry('pages', 'home')
if (!entry) throw new Error('Missing content collection entry: pages/home')

const { Content } = await render(entry)
---

<Base title={entry.data.title}>
  <nav class="site-nav">
    <a href="/">Home</a>
    <a href="/about">About</a>
  </nav>

  <h1 {...ed('home.title')}>{entry.data.title}</h1>
  <p class="intro" {...ed('home.intro')}>{entry.data.intro}</p>

  <div {...ed('home.body')}>
    <Content />
  </div>
</Base>
